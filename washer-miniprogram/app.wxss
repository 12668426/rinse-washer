/**app.wxss**/
/* ===== 主题 CSS 变量：深色模式（默认） ===== */
page {
  /* 背景 */
  --bg: #0c0a09;
  --bg-card: #1c1917;
  --bg-hero: linear-gradient(180deg, #1c1917 0%, #0c0a09 100%);
  /* 边框 */
  --border: #292524;
  --border-strong: #44403c;
  /* 文字 */
  --text: #fafaf9;
  --text-2: #e7e5e4;
  --text-3: #a8a29e;
  --text-4: #78716c;
  /* 导航栏 */
  --nav-bg: #0c0a09;
  --nav-text: white;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "SF Pro Display", sans-serif;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ===== 浅色模式（跟随系统） ===== */
@media (prefers-color-scheme: light) {
  page {
    --bg: #f5f5f4;
    --bg-card: #ffffff;
    --bg-hero: linear-gradient(180deg, #ffffff 0%, #f5f5f4 100%);
    --border: #e7e5e4;
    --border-strong: #d6d3d1;
    --text: #1c1917;
    --text-2: #44403c;
    --text-3: #78716c;
    --text-4: #a8a29e;
    --nav-bg: #ffffff;
    --nav-text: black;
  }
}

view, text, button { box-sizing: border-box; }
