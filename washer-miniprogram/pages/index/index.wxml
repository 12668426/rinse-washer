<!--pages/index/index.wxml-->
<view class="page state-{{stateClass}}">

  <!-- ===== 顶部状态条 ===== -->
  <view class="status-strip">
    <view class="status-dot"></view>
    <text class="status-text">{{statusText}}</text>
    <view class="status-sep"></view>
    <view class="status-item">
      <view class="ic ic-temp"></view>
      <text class="status-val">{{temp}}°C</text>
    </view>
    <view class="status-sep"></view>
    <view class="status-item">
      <view class="ic ic-mode"></view>
      <text class="status-val">{{modeLabel}}</text>
    </view>
  </view>

  <!-- ===== 时间 Hero ===== -->
  <view class="hero">
    <view class="hero-time">{{remainText}}</view>
    <view class="hero-stage">{{stageText}}</view>
    <view class="hero-track">
      <view class="hero-fill {{progressPct >= 100 ? 'is-done' : ''}}" style="width: {{progressPct}}%; transition-duration: {{progressTransition}}s;"></view>
    </view>
  </view>

  <!-- 报警条（条件渲染不占位） -->
  <view class="alarm" wx:if="{{alarmMsg}}">
    <view class="ic ic-warn"></view>
    <text class="alarm-text">{{alarmMsg}}</text>
  </view>

  <!-- ===== 模式 2x2 ===== -->
  <view class="modes">
    <view
      class="mode {{selectedMode === m.key ? 'on' : ''}}"
      wx:for="{{modes}}"
      wx:for-item="m"
      wx:key="key"
      data-key="{{m.key}}"
      bindtap="selectMode"
    >
      <view class="mode-icon mode-icon-{{m.key}}"></view>
      <view class="mode-body">
        <text class="mode-name">{{m.name}}</text>
        <text class="mode-desc">{{m.desc}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 控制行：主按钮变形 + 结束（仅运行中显示） ===== -->
  <view class="ctrl-row">
    <button class="primary primary-{{primaryAction}}" bindtap="onPrimary" disabled="{{!connected}}">
      <view class="primary-icon primary-icon-{{primaryAction}}"></view>
      <text class="primary-label">{{primaryLabel}}</text>
    </button>
    <button class="stop" wx:if="{{primaryAction === 'pause' || primaryAction === 'resume'}}" bindtap="onStop">
      <view class="stop-icon"></view>
    </button>
  </view>

  <!-- ===== 底部入口条 ===== -->
  <view class="footer">
    <view class="foot foot-bt" bindtap="goDevice">
      <view class="foot-ic foot-ic-bt"></view>
      <text class="foot-label">{{connected ? '已连接' : '连接设备'}}</text>
    </view>
    <view class="foot-sep"></view>
    <view class="foot foot-wifi" bindtap="goWifi">
      <view class="foot-ic foot-ic-wifi"></view>
      <text class="foot-label">WiFi 配网</text>
    </view>
  </view>

</view>
